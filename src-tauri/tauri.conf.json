{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liurium",
  "version": "0.1.0",
  "identifier": "io.github.greatmightycrow.liurium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liurium",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "preventOverflow": true,
        "theme": "Dark",
        "backgroundColor": "#111116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
