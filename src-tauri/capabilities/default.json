{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Add a permission only together with the feature that needs it and a documented reason (Security Model). Window buttons of the custom frame styles: M1-009. App commands: one allow-<command> each, M2-004.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "allow-app-info",
    "allow-current-project",
    "allow-add-project",
    "allow-list-projects",
    "allow-open-project",
    "allow-rename-project",
    "allow-remove-project",
    "allow-locate-project",
    "allow-separate-project-copy",
    "allow-get-settings",
    "allow-update-settings",
    "allow-restart-app",
    "allow-app-data-info",
    "allow-open-app-data-folder",
    "allow-prune-backups",
    "allow-reset-sync-warnings",
    "allow-list-notes",
    "allow-open-note",
    "allow-update-note",
    "allow-resolve-note-conflict",
    "allow-close-note",
    "allow-create-note",
    "allow-create-folder",
    "allow-rename-entry",
    "allow-move-entry",
    "allow-trash-entry",
    "allow-note-links",
    "allow-backlinks",
    "allow-project-tags",
    "allow-edit-property",
    "allow-property-kinds",
    "allow-set-property-kind",
    "allow-wait-note-changes",
    "allow-check-note-changes",
    "allow-reconcile-note",
    "allow-wait-close-question",
    "allow-answer-close-question",
    "allow-open-external-link"
  ]
}
